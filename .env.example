# Set your personal secret passcode to lock your site
MASTER_KEY=your_secret_passcode_here

# From your downloaded Google Service Account JSON file:
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Base64 string of private_key from JSON file (or raw string with \n)
GOOGLE_PRIVATE_KEY=paste_your_base64_encoded_private_key_here

# Folder ID from the Google Drive folder URL
GOOGLE_DRIVE_FOLDER_ID=paste_your_google_drive_folder_id_here
